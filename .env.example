# Copy this file to .env and fill in your real values there.
# .env is gitignored -- never commit real credentials.
# Do NOT paste real credentials into a chat/AI conversation; edit this file
# directly on the machine that will actually run src/mt5_executor.py.
#
# MT5_SERVER is broker-specific, e.g. "Deriv-Demo", "HFMarketsGlobal-Demo",
# etc. -- check your broker's MT5 login screen for the exact server name.

MT5_LOGIN=12345678
MT5_PASSWORD=YourDemoPasswordHere
MT5_SERVER=YourBroker-Demo
